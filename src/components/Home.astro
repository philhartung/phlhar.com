		img {
			border-radius: 8px;
		}

		ul {
			padding-left: 0px;
			list-style: none;
		}

		::selection {
			background-color: #4183D7;
			color: white;
		}

		::-moz-selection {
			background-color: #4183D7;
			color: white;
		}

		img::selection {
			background-color: transparent;
		}

		img::-moz-selection {
			background-color: transparent;
		}

		a, a:visited {
			color: #235da6;
		}
		
		a:hover{
			color: #4183D7;
		}

		@media (prefers-color-scheme: dark) {
			body {
				background-color: #151919;
				color: white;
			}

			body a, body a:visited {
				color: #508ddb;
			}

			body a:hover {
